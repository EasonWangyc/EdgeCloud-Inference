+        if (!timingCache)
+        {
+            LOG_ERROR("Failed to create TensorRT timing cache: %s", value);
+            return false;
+        }
+        if (!config->setTimingCache(*timingCache, false))
+        {
+            LOG_ERROR("TensorRT rejected timing cache for the current builder/device: %s", value);
+            return false;
+        }
+    }
